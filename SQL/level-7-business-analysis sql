--Q29: Payment Method Analysis 
SELECT payment_method,COUNT(*)
AS number_of_orders FROM orders GROUP BY payment_method
ORDER BY number_of_orders DESC
LIMIT 1;

--Q30: Category Revenue 
SELECT p.category, SUM(oi.quantity * oi.unit_price)
AS total_sales FROM products p INNER JOIN order_items oi
ON p.product_id=oi.product_id
GROUP BY p.category ORDER BY total_sales DESC
LIMIT 1;

--Q31: Customer Revenue 
SELECT c.customer_id,
CONCAT(c.first_name,' ',c.last_name),
AS customer_name,
SUM(oi.quantity *oi.unit_price)
AS total_spent FROM customers c INNER JOIN orders o
ON c.customer_id=o.customer_id INNER JOIN order_items oi
ON o.order_id=oi.order_id GROUP BY c.customer_id,
c.first_name,c.last_name ORDER BY total_spent DESC;

--Q32:Top 5 Customers
SELECT c.customer_id,CONCAT(c.first_name,' ',c.last_name)
AS c.customer_name,SUM(oi.quantity*oi.unit_price)AS total_spent
FROM customers c INNER JOIN orders o ON c.customer_id=o.customer_id
INNER JOIN order_items oi ON o.order_id=oi.order_id
GROUP BY c.customer_id,c.first_name,c.last_name 
ORDER BY total_spent DESC LIMIT 5;
